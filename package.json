{
  "name": "hfut-food-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "build": "npm run type-check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:worker": "wrangler dev --config dist/hfut_food_review/wrangler.json --ip 127.0.0.1",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy --config dist/hfut_food_review/wrangler.json",
    "format": "prettier --write src server tests docs *.ts *.json *.jsonc *.html README.md .github/workflows/ci.yml",
    "format:check": "prettier --check src server tests docs *.ts *.json *.jsonc *.html README.md .github/workflows/ci.yml"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.155.0"
  }
}
